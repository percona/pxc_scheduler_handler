# Config: writer_is_reader_2w.toml
# ACT1: node_3 — SET global wsrep_desync=1;
# ACT2: node_3 — SET global wsrep_desync=0;
--let $pxc_scheduler_handler_config = writer_is_reader_2w.toml
--let $action_1_node = node_3
--let $action_1 = SET global wsrep_desync=1;
--let $action_2_node = node_3
--let $action_2 = SET global wsrep_desync=0;
--let $act1_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=101 AND port=$NODE_MYPORT_3 AND status='OFFLINE_SOFT'
--let $act2_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=101 AND port=$NODE_MYPORT_3 AND status='ONLINE'
--source 2w3r2bw_2actions.inc
