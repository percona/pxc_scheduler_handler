# Config: writer_is_reader_2w.toml
# ACT1: node_1 — SET GLOBAL wsrep_reject_queries=ALL;
# ACT2: node_1 — SET GLOBAL wsrep_reject_queries=NONE;
--let $pxc_scheduler_handler_config = writer_is_reader_2w.toml
--let $action_1_node = node_1
--let $action_1 = SET GLOBAL wsrep_reject_queries=ALL;
--let $action_2_node = node_1
--let $action_2 = SET GLOBAL wsrep_reject_queries=NONE;
--let $act1_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=100 AND port=$NODE_MYPORT_1 AND status='OFFLINE_SOFT'
--let $act2_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=100 AND port=$NODE_MYPORT_1 AND status='ONLINE'
--source 2w3r2bw_2actions.inc
