# Config: writer_is_reader.toml
# ACT1: node_1 — SET GLOBAL read_only=1;
# ACT2: node_1 — SET GLOBAL read_only=0;
--let $pxc_scheduler_handler_config = writer_is_reader.toml
--let $action_1_node = node_1
--let $action_1 = SET GLOBAL read_only=1;
--let $action_2_node = node_1
--let $action_2 = SET GLOBAL read_only=0;
--let $act1_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=100 AND port=$NODE_MYPORT_2 AND status='ONLINE'
--let $act2_wait_condition = SELECT 1 FROM runtime_mysql_servers WHERE hostgroup_id=101 AND port=$NODE_MYPORT_1 AND status='ONLINE'
--source 1w3r2bw_2actions.inc
